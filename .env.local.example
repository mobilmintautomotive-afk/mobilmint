# =====================================================================
# MobilMint — konfigurasi environment
# Salin file ini jadi .env.local lalu isi nilainya dari Supabase Dashboard
# (Project Settings > API). JANGAN commit .env.local ke git.
# =====================================================================

# Wajib — dipakai server & browser
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Wajib untuk aksi admin (undang user di Fase 5). SERVER ONLY.
# Jangan pernah diberi prefix NEXT_PUBLIC_ — key ini melewati semua RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL aplikasi (dipakai di Fase 5 untuk redirect auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000
